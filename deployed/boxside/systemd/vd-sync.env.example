# Per-box settings for vd-sync-server.service. Copy to /etc/vantage-deployed/vd-sync.env,
# fill in, and keep it 0640 (it names paths, not secrets: the admin token lives in the state
# dir's config.json, printed by `vd-ops config`).
VD_INSTALL=/opt/vantage-deployed
VD_STATE_DIR=/var/lib/vantage-deployed
VD_BIND=127.0.0.1
VD_PORT=8095
VD_BOX=box
VD_BASE_URL=http://127.0.0.1:8095
VD_VAULT=/srv/vault/Deployed
# Optional: add --read-only in the unit's ExecStart to serve pulls only.
