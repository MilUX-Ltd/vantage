{
  "_comment": "Copy to /etc/vantage-console/targets.json. One entry per thing worth knowing about. Adding a non-TAK target is a new entry, not a code change. Replace the example hosts with your own.",
  "targets": [
    {
      "name": "nuc",
      "label": "Private TAK (this box)",
      "kind": "local",
      "command": "/usr/local/bin/tak-health",
      "profile": "nuc"
    },
    {
      "name": "cloud",
      "label": "Public TAK (your public server)",
      "kind": "ssh",
      "ssh": "takwatch@tak.example.com",
      "identity": "/var/lib/vantage-console/.ssh/id_ed25519",
      "profile": "cloud"
    },
    {
      "name": "deployed",
      "label": "Deployable kit",
      "kind": "ssh",
      "ssh": "takwatch@deployed.example.com",
      "identity": "/var/lib/vantage-console/.ssh/id_ed25519",
      "profile": "deployed",
      "expected_offline": true,
      "connect_timeout": 5
    }
  ]
}
