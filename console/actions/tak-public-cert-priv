#!/usr/bin/env bash
# tak-public-cert-priv - obtain a publicly trusted certificate for THIS box's enrolment
# port, proving control of the name through DNS rather than through an inbound connection.
#
#     takadmin ALL=(root) NOPASSWD: /usr/local/bin/tak-public-cert-priv
#
# Why this exists. A box on a private address can never satisfy Let's Encrypt's HTTP-01
# challenge: that challenge needs the CA to reach port 80 on the box from the internet,
# and 192.168.x.x is not reachable from anywhere. The provisioner used --standalone,
# which is HTTP-01, so every private box fell back to its own certificate authority. A
# device then cannot verify the enrolment port, so the plain QR cannot complete, and the
# whole data-package detour exists only to work around that.
#
# DNS-01 proves control by writing a TXT record in the zone. It needs no inbound
# connection and no public address, so a box on a private LAN gets a genuine certificate.
# With that on 8446, the device trusts the enrolment endpoint, collects its client
# certificate and the server's authority over that trusted channel, and the plain
# tak://com.atakmap.app/enroll QR is a single scan with nothing typed.
#
# The API token is a zone credential. It is written 0600, used, and left only where
# certbot needs it for renewal.
set -euo pipefail

deny() { echo "ERR $*" >&2; exit 2; }
say()  { echo "$*"; }

tokb64="${1:-}"
email="${2:-}"
[[ -n "$tokb64" ]] || deny "no API token supplied"
[[ "$tokb64" =~ ^[A-Za-z0-9+/=]{20,512}$ ]] || deny "bad token encoding"
token=$(printf '%s' "$tokb64" | base64 -d 2>/dev/null) || deny "token does not decode"
[[ "$token" =~ ^[A-Za-z0-9_-]{20,200}$ ]] || deny "that does not look like a Cloudflare API token"
[[ -z "$email" || "$email" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] \
    || deny "bad contact email"

FQDN=""
[[ -r /etc/tak-health.conf ]] && FQDN=$(sed -n 's/^ *fqdn *= *//p' /etc/tak-health.conf | tr -d '"'"'"' \t')
[[ -n "$FQDN" ]] || FQDN=$(hostname -f 2>/dev/null || hostname)
[[ "$FQDN" =~ ^[A-Za-z0-9.-]{4,253}$ && "$FQDN" == *.* ]] || deny "this box has no fully qualified name to certify"

CAPASS_FILE=/opt/tak/certs/.milux-capass
[[ -r "$CAPASS_FILE" ]] || deny "no certificate password on this box"
pass=$(head -1 "$CAPASS_FILE")
CC=/opt/tak/CoreConfig.xml
[[ -w "$CC" ]] || deny "no CoreConfig.xml to update"

say "name: $FQDN"

CREDS=/etc/letsencrypt/cloudflare.ini
install -d -m 700 /etc/letsencrypt
umask 077
printf 'dns_cloudflare_api_token = %s\n' "$token" > "$CREDS"
chmod 600 "$CREDS"

export DEBIAN_FRONTEND=noninteractive
apt-get install -y -qq certbot python3-certbot-dns-cloudflare >/dev/null 2>&1 \
    || deny "could not install the certbot Cloudflare plugin (is this box online?)"

# Propagation: Cloudflare is fast, but the CA reads from a resolver that may not be.
args=(certonly --dns-cloudflare --dns-cloudflare-credentials "$CREDS"
      --dns-cloudflare-propagation-seconds 30
      -d "$FQDN" --agree-tos --no-eff-email --non-interactive --keep-until-expiring)
if [[ -n "$email" ]]; then args+=(-m "$email"); else args+=(--register-unsafely-without-email); fi

if ! out=$(certbot "${args[@]}" 2>&1); then
    printf '%s\n' "$out" | tail -12 >&2
    deny "certbot could not obtain a certificate for $FQDN"
fi
LIVE=/etc/letsencrypt/live/$FQDN
[[ -s "$LIVE/fullchain.pem" && -s "$LIVE/privkey.pem" ]] \
    || deny "certbot reported success but no certificate is on disk"

# Prove it is genuinely a public certificate and not the box's own, before it is trusted
# with the job. An issuer of MILUX-ISSUING-CA here would mean nothing had changed.
issuer=$(openssl x509 -in "$LIVE/fullchain.pem" -noout -issuer 2>/dev/null || echo "")
say "issuer:$issuer"
grep -qi "MILUX" <<<"$issuer" && deny "that certificate is still self-signed; refusing to install it"

LE_JKS=/opt/tak/certs/files/le.jks
cat > /opt/tak/renew-tak-le <<HOOK
#!/usr/bin/env bash
set -e
openssl pkcs12 -export -in $LIVE/fullchain.pem \
  -inkey $LIVE/privkey.pem -out /opt/tak/certs/files/le.p12 \
  -name $FQDN -passin pass:$pass -passout pass:$pass
rm -f $LE_JKS
keytool -importkeystore -destkeystore $LE_JKS -srckeystore /opt/tak/certs/files/le.p12 \
  -srcstoretype pkcs12 -deststorepass "$pass" -destkeypass "$pass" -srcstorepass "$pass"
chown tak:tak $LE_JKS /opt/tak/certs/files/le.p12
HOOK
chmod 700 /opt/tak/renew-tak-le
/opt/tak/renew-tak-le >/dev/null 2>&1 || deny "could not build the Java keystore from the certificate"
[[ -s "$LE_JKS" ]] || deny "keystore was not produced"

# One connector on 8446, never two: the .deb ships a bare cert_https and a second one
# stops the API process starting, which takes 8443 down with it.
if ! grep -q "cert_https_LE" "$CC"; then
    sed -i '/<connector port="8446"/d' "$CC"
    con="<connector port=\"8446\" clientAuth=\"false\" _name=\"cert_https_LE\" keystore=\"JKS\" keystoreFile=\"certs/files/le.jks\" keystorePass=\"$pass\" enableAdminUI=\"true\" enableWebtak=\"false\" enableNonAdminUI=\"false\"/>"
    sed -i "s#</network>#${con}</network>#" "$CC"
fi
echo '0 */12 * * * root certbot -q renew && /opt/tak/renew-tak-le' > /etc/cron.d/tak-le-renew

systemctl restart takserver >/dev/null 2>&1 || deny "TAK Server would not restart"

# Do not report success on a restart alone. 8446 is the port the whole point rests on.
for _ in $(seq 1 60); do
    ss -ltn 2>/dev/null | grep -q ':8446' && break
    sleep 2
done
ss -ltn 2>/dev/null | grep -q ':8446' || deny "TAK restarted but 8446 is not listening"

# And the certificate it now serves must be the public one. Ask the port, do not assume.
served=$(echo | timeout 15 openssl s_client -connect "127.0.0.1:8446" -servername "$FQDN" 2>/dev/null \
         | openssl x509 -noout -issuer 2>/dev/null || echo "")
say "serving:$served"
grep -qi "MILUX" <<<"$served" && deny "8446 is still serving this box's own certificate"

echo "OK $FQDN"
echo "PUBLICCERT yes"
