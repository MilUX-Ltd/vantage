#!/usr/bin/env bash
# tak-list-credentials - the ONE operation the console's list-credentials key may run: list the
# device credentials on this box. Names and metadata only, never secret material, so this is a
# read: no passphrase.
#
# Reached only through an SSH forced command:
#     command="/usr/local/bin/tak-list-credentials",restrict ssh-ed25519 AAAA... vantage-console-credlist
set -euo pipefail
deny() { echo "ERR $*" >&2; exit 2; }
read -r verb extra <<<"${SSH_ORIGINAL_COMMAND:-}"
[[ "$verb" == "list-credentials" ]] || deny "only list-credentials is permitted on this key"
[[ -z "${extra:-}" ]]               || deny "this action takes no arguments"
exec sudo -n /usr/local/bin/tak-list-credentials-priv
