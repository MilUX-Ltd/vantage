#!/usr/bin/env bash
# tak-enrol-device-priv - the single privileged step behind enrol-device: create or reset
# ONE enrolment credential in this TAK server's UserAuthenticationFile.
#
# Runs as root, reachable ONLY through a scoped sudoers rule from the takadmin user:
#     takadmin ALL=(root) NOPASSWD: /usr/local/bin/tak-enrol-device-priv
#
# The password is generated here BY DEFAULT; the operator MAY supply their own, which
# arrives base64-encoded and is validated against the same policy the generator meets:
# 15-64 chars, upper + lower + digit + a symbol, from a charset that stays URL-safe
# unencoded in the enrolment QR (letters, digits, ! . _ ~ -). Weak cannot arrive,
# whoever chose it. UserManager quirk, learned the hard way: it has no flag parser -
# '--help' becomes a username - so arguments are re-validated hard and dashes are refused.
set -euo pipefail

deny() { echo "ERR $*" >&2; exit 2; }

user="${1:-}"; group="${2:-}"; pwb64="${3:-}"; host="${4:-}"
# The enrolment host, for the data package below. Validated as hard as everything else:
# it goes into a preference file the device acts on, so no shell or XML metacharacters.
[[ -z "$host" || "$host" =~ ^[A-Za-z0-9._-]{1,253}$ ]] || deny "bad enrolment host"
[[ "$user"  =~ ^[A-Za-z0-9._-]{1,40}$ ]] || deny "user must match [A-Za-z0-9._-], 1-40 chars"
[[ "$user" != -* ]]                      || deny "user may not begin with a dash"
[[ "$group" =~ ^[A-Za-z0-9_-]{1,40}$ ]]  || deny "group must match [A-Za-z0-9_-], 1-40 chars"
[[ "$group" != -* ]]                     || deny "group may not begin with a dash"
if [[ -n "$pwb64" ]]; then
    [[ "$pwb64" =~ ^[A-Za-z0-9+/=]{4,88}$ ]] || deny "bad password encoding"
    pass=$(printf '%s' "$pwb64" | base64 -d 2>/dev/null) || deny "password does not decode"
    [[ "$pass" =~ ^[A-Za-z0-9._~!-]{15,64}$ ]] \
        || deny "password policy: 15-64 chars from letters, digits and ! . _ ~ -"
    [[ "$pass" =~ [A-Z] && "$pass" =~ [a-z] && "$pass" =~ [0-9] && "$pass" =~ [._~!-] ]] \
        || deny "password policy: needs an upper, a lower, a digit and a symbol (! . _ ~ -)"
else
    # 14 random alphanumerics + a fixed class-completing tail = 18 chars, policy-satisfying.
    rand=$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 14) || true
    [[ ${#rand} -eq 14 ]] || deny "could not gather randomness"
    pass="${rand}Xk7!"
fi

[[ -f /opt/tak/utils/UserManager.jar ]]  || deny "no UserManager.jar on this box"


cd /opt/tak
if ! out=$(timeout 30 java -jar utils/UserManager.jar usermod -g "$group" -p "$pass" "$user" 2>&1); then
    printf '%s\n' "$out" | tail -4 >&2
    deny "UserManager failed"
fi
grep -qiE "error|not.*usable" <<<"$out" && { printf '%s\n' "$out" | tail -4 >&2; deny "UserManager reported a problem"; }

# Persist the token so the console can re-render this QR later (fetch-credential). The store is
# root-owned 0700, one file per user 0600 - a bearer credential, held exactly as tightly as the
# UserAuthenticationFile it mirrors. Best-effort: a failure here must not fail the enrolment,
# which already succeeded above, so the QR still reaches the operator.
store=/var/lib/tak-credentials/enrol
if install -d -m 700 -o root -g root /var/lib/tak-credentials "$store" 2>/dev/null; then
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    tmp=$(mktemp "$store/.$user.XXXXXX") && {
        printf '{"user":"%s","group":"%s","token":"%s","created":"%s"}\n' \
            "$user" "$group" "$pass" "$now" > "$tmp"
        chmod 600 "$tmp"; mv -f "$tmp" "$store/$user.json"
    } || true
fi

echo "USER $user"
echo "PASS $pass"

# ---- the data package the device needs BEFORE the QR can work ---------------------
# This box signs its own certificates, so it presents a TLS certificate from a CA no
# device has ever seen. ATAK refuses with "the TAK server's identity could not be
# verified" - correctly: the QR carries host, username and password and no certificate
# authority at all. This is the missing half. Best-effort, exactly like the token store
# above: the credential already exists and must still reach the operator if this fails.
# The join package. Two shapes, and the difference is whether the operator has to
# type anything.
#
#   Certificate package (preferred). We mint the device's client certificate here and
#   ship it inside. The device arrives already holding an identity, so there is no
#   enrolment step, no username and no password: one scan is the whole join. This is
#   the shape common/build-enrollment-dp.py has produced for WinTAK since March 2024.
#
#   Enrolment package (fallback). Trust only. The device then logs in with the
#   username and password so the server can issue it a certificate. TAK's auto-
#   enrolment always asks for those, so this shape can never be one scan.
#
# We take the certificate route whenever the box can mint one, and fall back rather
# than fail: a box that cannot issue a certificate still gets its operator joined.
# The truststore a DEVICE needs is the one the SERVER trusts, and that is not the root.
# Enrolment signs device certificates with the ISSUING CA, so a store holding only the
# root cannot build a path to the server's certificate: the device imports the package
# without complaint and then says "remote host certificate not trusted, check truststore".
# The provisioner learned this on 28 Aug and fixed it for the server's own truststore;
# the packages handed to devices kept shipping the root-only one. Read it out of
# CoreConfig rather than guessing a name, so whatever the server trusts is what the
# device is given.
estate_truststore() {
    local cc=/opt/tak/CoreConfig.xml ts=""
    if [[ -r "$cc" ]]; then
        ts=$(sed -n 's#.*truststoreFile="certs/files/\(truststore-[^"]*\)\.jks".*#\1#p' "$cc" \
             | head -1)
    fi
    if [[ -n "$ts" && -s "/opt/tak/certs/files/$ts.p12" ]]; then
        echo "/opt/tak/certs/files/$ts.p12"; return 0
    fi
    # Nothing in CoreConfig: take any issuing-CA store over the root one.
    local c
    for c in /opt/tak/certs/files/truststore-*.p12; do
        [[ -s "$c" && "$c" != */truststore-root.p12 ]] && { echo "$c"; return 0; }
    done
    [[ -s /opt/tak/certs/files/truststore-root.p12 ]] \
        && echo /opt/tak/certs/files/truststore-root.p12
}
TS=$(estate_truststore)
CAPASS_FILE=/opt/tak/certs/.milux-capass
CERTBUILDER=/usr/local/bin/build-enrollment-dp.py
CERTS=/opt/tak/certs

pkg=""
if [[ -n "$host" && -n "$TS" && -s "$TS" && -r "$CAPASS_FILE" && -x "$CERTBUILDER" && -x "$CERTS/makeCert.sh" ]]; then
    capass=$(head -1 "$CAPASS_FILE")
    P12="$CERTS/files/$user.p12"
    # Re-enrolling a device reuses the certificate it already has. makeCert.sh
    # refuses to overwrite, and issuing a second certificate for one name leaves the
    # first valid and unaccounted for.
    if [[ ! -s "$P12" ]]; then
        ( cd "$CERTS" && timeout 120 ./makeCert.sh client "$user" ) >/tmp/.enrol-cert.$$ 2>&1 \
            || echo "PKGNOTE could not mint a client certificate for $user" >&2
        rm -f "/tmp/.enrol-cert.$$"
    fi
    if [[ -s "$P12" ]]; then
        tmpz=$(mktemp -u /tmp/.enrolpkg.$$.XXXXXX.zip)
        if timeout 60 "$CERTBUILDER" --host "$host" --port 8089 \
                --description "$host" --username "$user" \
                --ca "$TS" --ca-password "$capass" \
                --client-cert "$P12" --client-password "$capass" \
                --name "$user" --out "$tmpz" >/dev/null 2>&1 && [[ -s "$tmpz" ]]; then
            pkg=$(base64 -w0 "$tmpz" 2>/dev/null || base64 "$tmpz" | tr -d '\n')
            echo "PKGKIND cert"
        else
            echo "PKGNOTE certificate package would not build" >&2
        fi
        rm -f "$tmpz"
    fi
fi

# The fallback uses the SAME builder without a client certificate. One builder, two
# modes, and the mode is the presence of --client-cert. The second implementation
# written for this was never proven on a device and wrote two manifests into the zip
# where the proven one writes exactly one; the device answered with an IO error.
if [[ -z "$pkg" && -n "$host" && -n "$TS" && -s "$TS" && -r "$CAPASS_FILE" && -x "$CERTBUILDER" ]]; then
    capass=$(head -1 "$CAPASS_FILE")
    tmpz=$(mktemp -u /tmp/.enrolpkg.$$.XXXXXX.zip)
    if timeout 60 "$CERTBUILDER" --host "$host" --port 8089 \
            --description "$host" --username "$user" --password "$pass" \
            --ca "$TS" --ca-password "$capass" \
            --name "$user" --out "$tmpz" >/dev/null 2>&1 && [[ -s "$tmpz" ]]; then
        pkg=$(base64 -w0 "$tmpz" 2>/dev/null || base64 "$tmpz" | tr -d '\n')
        echo "PKGKIND enrol"
    else
        echo "PKGERR could not build a join package" >&2
    fi
    rm -f "$tmpz"
fi

[[ -n "$pkg" ]] && echo "PKG $pkg"
