    live="/etc/letsencrypt/live/$fqdn"
    [[ -f "$live/fullchain.pem" && -f "$live/privkey.pem" ]] \
        || deny "no Let's Encrypt certificate for $fqdn on this box"
    install -d -m 750 -o vantage-console -g vantage-console /etc/vantage-console/tls
    install -m 640 -o vantage-console -g vantage-console "$live/fullchain.pem" /etc/vantage-console/tls/fullchain.pem
    install -m 600 -o vantage-console -g vantage-console "$live/privkey.pem" /etc/vantage-console/tls/privkey.pem
    hook=/etc/letsencrypt/renewal-hooks/deploy/vantage-console-tls
    install -d -m 755 /etc/letsencrypt/renewal-hooks/deploy
    {
        echo '#!/bin/sh'
        echo '# keep the console copy of the certificate fresh after every renewal'
        echo "install -m 640 -o vantage-console -g vantage-console '$live/fullchain.pem' /etc/vantage-console/tls/fullchain.pem"
        echo "install -m 600 -o vantage-console -g vantage-console '$live/privkey.pem' /etc/vantage-console/tls/privkey.pem"
        # restart whichever console unit this box runs (deployed edition = vantage-console-deployed,
        # admin edition = vantage-console) so the renewed cert is actually picked up
        echo 'systemctl restart vantage-console-deployed.service 2>/dev/null || systemctl restart vantage-console.service 2>/dev/null || true'
    } > "$hook"
    chmod 755 "$hook"
    log "tlscert $fqdn"
    echo "OK https material staged for $fqdn"
    ;;
vaultdir)
