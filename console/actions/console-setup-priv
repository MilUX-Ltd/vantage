    while read -r _nm mnt rm typ; do
        [[ "$typ" == "part" && "$rm" == "1" && -n "$mnt" && "$mnt" != "/" ]] || continue
        [[ -d "$mnt" && -w "$mnt" ]] || continue
        dest="$mnt"; break
    done < <(lsblk -o NAME,MOUNTPOINT,RM,TYPE -nrp 2>/dev/null)
    [[ -n "$dest" ]] || deny "no writable USB stick is mounted"
    target="$dest/Vantage-$sub-$(date -u +%Y%m%d-%H%M%S)"
    mkdir -p "$target" || deny "could not write to the USB stick"
    n=0
    for f in "$srcdir"/*; do
        [[ -f "$f" ]] || continue
        cp -f "$f" "$target/" || deny "copy to USB failed"
        n=$((n + 1))
    done
    sync
    log "usb-export $sub ($n files)"
    echo "OK $target ($n files)"
    ;;
usb-import)
    # disconnected ingest: LIST importable files on a mounted USB stick, or STAGE one into
    # the console's agent dir for the console to file into the library/shelf. Read-only on
    # the USB; the console (not root) records the manifest. Same removable detection as
    # usb-copy.  Called: usb-import list  |  usb-import stage <filename>.
    mode="$name"
    [[ "$mode" =~ ^(list|stage)$ ]] || deny "usb-import mode must be list or stage"
    src=""
    while read -r _nm mnt rm typ; do
        [[ "$typ" == "part" && "$rm" == "1" && -n "$mnt" && "$mnt" != "/" ]] || continue
        [[ -d "$mnt" && -r "$mnt" ]] || continue
        src="$mnt"; break
    done < <(lsblk -o NAME,MOUNTPOINT,RM,TYPE -nrp 2>/dev/null)
    [[ -n "$src" ]] || deny "no readable USB stick is mounted"
    if [[ "$mode" == "list" ]]; then
        # .tgz is here so a Vantage release cut can be carried in on a stick: without it
        # an offline box could never be updated at all, only rebuilt.
        find "$src" -maxdepth 1 -type f \( -iname '*.deb' -o -iname '*.apk' \
             -o -iname '*.tar' -o -iname '*.tar.gz' -o -iname '*.tgz' -o -iname '*.zip' \) \
             -printf '%f\t%s\n' 2>/dev/null | head -200
        exit 0
    fi
    fname="${1:-}"
    [[ "$fname" =~ ^[A-Za-z0-9._-]{1,120}$ ]] || deny "bad filename"
    [[ -f "$src/$fname" ]] || deny "no such file on the USB"
    stagedir=/var/lib/vantage-console/agent/usb-import
    install -d -m 0750 -o vantage-console -g vantage-console "$stagedir"
    cp -f "$src/$fname" "$stagedir/$fname" || deny "copy from USB failed"
    chown vantage-console:vantage-console "$stagedir/$fname"
    chmod 0640 "$stagedir/$fname"
    log "usb-import stage $fname"
    echo "OK $stagedir/$fname"
    ;;
rename)
    # operator-assigned display label for an enrolled server: rewrite targets.json
    # under the enrol lock, then poll so the new name shows at once. The label is
    # decoded from base64 and character-classed hard; the name must already exist.
    labelb64="${1:-}"
    label=$(printf '%s' "$labelb64" | base64 -d 2>/dev/null | head -c 40 | tr -cd 'A-Za-z0-9()., _-')
    [[ -n "$label" ]] || deny "empty or invalid label"
    exec 9>/etc/vantage-console/.enrol.lock
    flock 9
    out=$(python3 -c "$PY_SNIPPET_4" "$name" "$label"
)
    [[ "$out" == "OK" ]] || deny "no enrolled server called '$name'"
    systemctl start vantage-console-collect.service 2>/dev/null || true
    log "rename $name -> '$label'"
    echo "OK renamed"
    ;;
forget-host)
    # a rebuilt box has a new host key; forgetting the old one is deliberate, operator-driven
    host="${1:-}"
    [[ "$host" =~ ^[A-Za-z0-9.-]{1,253}$ ]] || deny "bad host"
    ssh-keygen -R "$host" -f /var/lib/console-setup/known_hosts >/dev/null 2>&1 || true
    ip=$(getent ahostsv4 "$host" 2>/dev/null | awk '{print $1; exit}')
    [[ -n "$ip" ]] && ssh-keygen -R "$ip" -f /var/lib/console-setup/known_hosts >/dev/null 2>&1
    if [[ -f /var/lib/vantage-console/.ssh/known_hosts ]]; then
        ssh-keygen -R "$host" -f /var/lib/vantage-console/.ssh/known_hosts >/dev/null 2>&1 || true
        [[ -n "$ip" ]] && ssh-keygen -R "$ip" -f /var/lib/vantage-console/.ssh/known_hosts >/dev/null 2>&1
        chown vantage-console:vantage-console /var/lib/vantage-console/.ssh/known_hosts 2>/dev/null || true
    fi
    log "forget-host $host${ip:+ ($ip)}"
    echo "OK forgotten"
    ;;
have)
    # does a bootstrap key already exist under this name? Lets a reloaded wizard
    # page rediscover a key it adopted before the reload, instead of demanding a
    # fresh paste. Read-only; prints HELD or ABSENT and succeeds either way.
    if [[ -f "$key" ]]; then echo "HELD"; else echo "ABSENT"; fi
    ;;
shred)
    if [[ -f "$key" ]]; then
        shred -u "$key" 2>/dev/null || rm -f "$key"
        rm -f "$key.pub"
        log "shred $name"
        echo "OK bootstrap key destroyed"
    else
        echo "OK no key to destroy"
    fi
    ;;
apply-release)
    # Install a staged release onto this box. The work is DETACHED on purpose: it restarts
    # the console, which is the process asking for it, so anything running inside this call
    # would be killed halfway through its own update. systemd-run outlives that; setsid is
    # the fallback for a box without it. The verdict is left in
    # /var/lib/vantage-console/last-apply.json for whatever console comes back.
    # $1, not $3. `op` and `name` are shifted off the front above, so a branch's own
    # arguments start at $1 like every other branch here. Reading $3 made this always
    # empty, so the Install button denied "archive must be a .tgz filename" every time
    # it was ever pressed. Nothing caught it: the helper it launches is tested hard, and
    # the call that has to reach the helper was not tested at all.
    archive="${1:-}"
    [[ "$archive" =~ ^[A-Za-z0-9._-]{1,120}\.tgz$ ]] || deny "archive must be a .tgz filename"
    full="/var/lib/vantage-console/agent/store/updates/$archive"
    [[ -f "$full" ]] || deny "no staged release called $archive"
    [[ -x /usr/local/bin/vantage-apply-release ]] || deny "the apply helper is not installed"
    rm -f /var/lib/vantage-console/last-apply.json
    if command -v systemd-run >/dev/null 2>&1; then
        systemd-run --unit=vantage-apply-release --collect --quiet \
            /usr/local/bin/vantage-apply-release "$full" \
            || deny "could not start the apply"
    else
        setsid nohup /usr/local/bin/vantage-apply-release "$full" \
            >/var/lib/console-setup/apply.log 2>&1 < /dev/null &
        disown 2>/dev/null || true
    fi
    log "apply-release $archive"
    echo "OK applying $archive; the console will restart"
    ;;
kiosk-exit)
    # the on-screen exit from kiosk mode: stop the full-screen browser and hand the box's
    # screen back to a login terminal. The console gates the caller (loopback only); this
    # just does the privileged toggle. Idempotent - no kiosk, no harm.
    systemctl stop vantage-kiosk.service 2>/dev/null || true
    systemctl start getty@tty1.service 2>/dev/null || true
    log "kiosk-exit"
    echo "OK kiosk stopped; the screen is a login terminal"
    ;;
esac
