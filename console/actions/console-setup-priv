enrol)
    dest="${1:-}"; ename="${2:-}"; profile="${3:-}"; labelb64="${4:-}"; fqdn="${5:-}"; components="${6:-}"
    valid_dest "$dest" || deny "destination must look like user@host"
    [[ "$ename" =~ ^[a-z0-9-]{1,24}$ ]] || deny "estate name must match [a-z0-9-], max 24"
