#!/usr/bin/env bash
# console-setup-priv - the console's ONE root path on the console box, for the server setup
# wizard. Approved by Matt, 26 Aug 2026: browser-driven deploy of a new TAK server, judged
# safer than an admin doing the same work by hand.
#
# Reached ONLY through a scoped sudoers rule:
#     vantage-console ALL=(root) NOPASSWD: /usr/local/bin/console-setup-priv
#
# The same catalogue discipline as every box action: five named operations, every argument
# hard-validated, nothing resembling a shell. Bootstrap keys live in a root-only store,
# referenced by NAME (never a caller-supplied path), and are shredded when setup ends - the
# end state is identical to a hand enrolment: the console holds only its scoped action keys.
#
#   keygen  <name>                     mint a bootstrap keypair; prints the PUBLIC key for the
#                                      operator to place on the new box (root authorized_keys)
#   userkey <name>                     adopt a private key the operator uploaded via the console
#                                      (read from the agent setup dir, moved into the root store,
#                                      origin shredded)
#   test    <name> <user@host>         prove the bootstrap route: connect, print the far hostname
#   enrol   <name> <user@host> <estate-name> <profile> <label-b64>
#                                      run console-enrol-server over the bootstrap key
#   push-deb <name> <user@host> <file> <sha256>
#                                      copy a package from the console's library to
#                                      /root/<file> on the box, hash-verified both ends
#   shred   <name>                     destroy the bootstrap key (always the last step)
#
# Every run is appended to /var/log/console-setup.log.
set -uo pipefail

deny() { echo "ERR $*" >&2; exit 2; }

STORE=/var/lib/console-setup/keys
AGENT_SETUP=/var/lib/vantage-console/agent/setup
# packages live in the tak-server folder of the console's filestore
LIBRARY=/var/lib/vantage-console/agent/store/tak-server
# lives under /var/lib/console-setup (not /var/log): the helper runs inside the console
# service's mount namespace, where only carved paths are writable
LOG=/var/lib/console-setup/setup.log

log() {
    printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$LOG" 2>/dev/null || true
}

op="${1:-}"; shift || true
name="${1:-}"; shift || true
[[ "$op" =~ ^(keygen|userkey|test|enrol|push-deb|shred|have|rename|forget-host|instance|unenrol|set-password|self-authorize|vaultdir|tlscert|baseline|usb-copy|usb-import|usb-export|kiosk-exit|apply-release)$ ]] || deny "unknown operation"
[[ "$name" =~ ^[a-z0-9-]{1,24}$ ]] || deny "key name must match [a-z0-9-], max 24"
key="$STORE/$name"
install -d -m 700 -o root -g root /var/lib/console-setup "$STORE"

valid_dest() { [[ "$1" =~ ^[A-Za-z0-9._-]+@[A-Za-z0-9._-]+$ ]]; }

