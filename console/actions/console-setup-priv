        [[ -f "$key" ]] && { rm -f "$key" "$key.pub"; log "keygen $name (rotated, old key discarded)"; }
    else
        [[ -f "$key" ]] && { log "keygen $name (existing)"; cat "$key.pub"; exit 0; }
    fi
    ssh-keygen -t ed25519 -N "" -C "vantage-console-setup-$name" -f "$key" -q || deny "keygen failed"
    chmod 600 "$key"
    log "keygen $name"
    cat "$key.pub"
    ;;
self-authorize)
    # "Deploy on this box": the console's own box becomes the target. Mint the bootstrap
    # key if absent and authorise it for root ON THIS BOX - the operator pastes nothing,
    # because the box already trusts itself; the same shred-on-success lifecycle applies,
    # so the self-trust is temporary. Everything downstream (enrol, provision) then runs
    # through the identical path as any remote box, aimed at root@127.0.0.1.
    if [[ ! -f "$key" ]]; then
        ssh-keygen -t ed25519 -N "" -C "vantage-console-setup-$name" -f "$key" -q || deny "keygen failed"
        chmod 600 "$key"
    fi
