    # and install a renewal deploy-hook so it stays fresh. data = the fqdn.
    fqdn="${1:-}"
    fqdn_re='^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$'
