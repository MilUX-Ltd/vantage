        systemd-run --quiet --wait --collect -p User=root \
            /bin/grep -qF "$pub" /root/.ssh/authorized_keys 2>/dev/null \
            || grep -qF "$pub" /root/.ssh/authorized_keys \
            || deny "could not authorise the key for root on this box"
