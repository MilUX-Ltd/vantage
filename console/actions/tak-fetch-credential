#!/usr/bin/env bash
# tak-fetch-credential - the ONE operation the console's fetch-credential key may run: return one
# device credential for re-download. This returns SECRET material (a private-key .p12, or an
# enrolment token and its QR), so the console gates it behind the operator password exactly as
# it gates issuing one.
#
# Reached only through an SSH forced command:
#     command="/usr/local/bin/tak-fetch-credential",restrict ssh-ed25519 AAAA... vantage-console-credfetch
set -euo pipefail
deny() { echo "ERR $*" >&2; exit 2; }
read -r verb ctype name extra <<<"${SSH_ORIGINAL_COMMAND:-}"
[[ "$verb" == "fetch-credential" ]]  || deny "only fetch-credential is permitted on this key"
[[ -z "${extra:-}" ]]                || deny "too many arguments"
[[ "$ctype" =~ ^(cert|enrol)$ ]]     || deny "type must be cert or enrol"
[[ "$name" =~ ^[A-Za-z0-9._-]{1,40}$ ]] || deny "name must match [A-Za-z0-9._-], 1-40 chars"
[[ "$name" != -* ]]                  || deny "name may not begin with a dash"
exec sudo -n /usr/local/bin/tak-fetch-credential-priv "$ctype" "$name"
