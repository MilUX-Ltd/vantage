#!/usr/bin/env bash
# tak-fetch-credential-priv - return one issued credential for re-download.
#   cert : the .p12 for a client certificate that already exists on the box, base64.
#   enrol: the stored enrolment token for <name>, with its URL and a freshly-rendered QR, rebuilt
#          from the current enrol host so a moved server still produces a scannable code.
#
# Root-only, reached through the sudoers-scoped wrapper:
#   takadmin ALL=(root) NOPASSWD: /usr/local/bin/tak-fetch-credential-priv
# The console gates this behind the operator password; nothing weakens that here.
set -euo pipefail
deny() { echo "ERR $*" >&2; exit 2; }

ctype="${1:-}"; name="${2:-}"
[[ "$ctype" =~ ^(cert|enrol)$ ]]        || deny "bad type"
[[ "$name" =~ ^[A-Za-z0-9._-]{1,40}$ ]] || deny "bad name"

if [[ "$ctype" == "cert" ]]; then
    p12="/opt/tak/certs/files/$name.p12"
    [[ -f "$p12" ]] || deny "no certificate '$name' on this box"
    echo "OK $name"
    echo "TYPE cert"
    echo "FILE $name.p12"
    echo "P12 $(base64 -w0 "$p12")"
    exit 0
fi

# enrol
store=/var/lib/tak-credentials/enrol
j="$store/$name.json"
[[ -f "$j" ]] || deny "no stored enrolment token for '$name' - tokens minted before the credential store existed cannot be recovered; reissue with enrol-device"
token=$(python3 -c "import json;print(json.load(open('$j')).get('token',''))" 2>/dev/null || true)
[[ -n "$token" ]] || deny "stored token for '$name' is empty"

host=""
[[ -r /etc/tak-enrol-host ]] && host=$(head -1 /etc/tak-enrol-host | tr -d '[:space:]')
[[ -n "$host" ]] || host=$(hostname -f 2>/dev/null || hostname)
url="tak://com.atakmap.app/enroll?host=${host}&username=${name}&token=${token}"

echo "OK $name"
echo "TYPE enrol"
echo "URL $url"
echo "ITAK ${host},${name},${token}"
if command -v qrencode >/dev/null 2>&1; then
    echo "PNG $(qrencode -t PNG -o - -m 3 -s 6 "$url" | base64 -w0)"
fi
