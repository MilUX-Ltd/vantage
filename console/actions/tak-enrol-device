#!/usr/bin/env bash
# tak-enrol-device - the ONE operation the console's enrol-device key is allowed to run.
#
# Reached only through an SSH forced command:
#     command="/usr/local/bin/tak-enrol-device",restrict ssh-ed25519 AAAA... vantage-console-enrol
#
# Creates (or resets) an enrolment credential on this TAK server and returns a QR code a
# phone can scan to join. The privileged half (UserManager against UserAuthenticationFile)
# is behind the sudoers-scoped wrapper; this half validates hard, then renders the QR
# unprivileged with qrencode.
#
# The enrolment host is a per-box fact, NOT hostname -f (the cloud box's hostname is
# 'milux' but phones enrol against tak.example.com). It is read from /etc/tak-enrol-host,
# a root-written one-line file; absent falls back to hostname -f with its eyes open.
#
# Output on success (stdout, one field per line, for the console to render):
#     OK <username>
#     PASS <password>
#     URL tak://com.atakmap.app/enroll?host=...&username=...&token=...
#     ITAK <name>,<host>,8089,ssl
#     PNG <base64 of a PNG QR of the URL line>
#     TRUSTED yes|no - whether a stock device already trusts this server's certificate
set -euo pipefail

deny() { echo "ERR $*" >&2; exit 2; }

read -r verb user group pwb64 extra <<<"${SSH_ORIGINAL_COMMAND:-}"
[[ "$verb" == "enrol-device" ]] || deny "only enrol-device is permitted on this key"
[[ -z "${extra:-}" ]]           || deny "too many arguments"
# optional operator-chosen password, base64 over the wire; policy is enforced in the
# privileged half, so nothing weak can arrive however it is encoded
[[ -z "${pwb64:-}" || "$pwb64" =~ ^[A-Za-z0-9+/=]{4,88}$ ]] || deny "bad password encoding"
[[ -n "${user:-}" && -n "${group:-}" ]] || deny "usage: enrol-device <user> <group>"
[[ "$user"  =~ ^[A-Za-z0-9._-]{1,40}$ ]] || deny "user must match [A-Za-z0-9._-], 1-40 chars"
[[ "$user" != -* ]]                      || deny "user may not begin with a dash"
[[ "$group" =~ ^[A-Za-z0-9_-]{1,40}$ ]]  || deny "group must match [A-Za-z0-9_-], 1-40 chars"
[[ "$group" != -* ]]                     || deny "group may not begin with a dash"

command -v qrencode >/dev/null 2>&1 || deny "qrencode is not installed on this box"

host=""
[[ -r /etc/tak-enrol-host ]] && host=$(head -1 /etc/tak-enrol-host | tr -d '[:space:]')
[[ -n "$host" ]] || host=$(hostname -f 2>/dev/null || hostname)

# The privileged half creates the credential and prints USER/PASS lines.
out=$(sudo -n /usr/local/bin/tak-enrol-device-priv "$user" "$group" "${pwb64:-}" "$host") || exit 2
pass=$(awk '$1=="PASS"{print $2}' <<<"$out")
[[ -n "$pass" ]] || deny "credential step returned no password"

url="tak://com.atakmap.app/enroll?host=${host}&username=${user}&token=${pass}"
png=$(qrencode -t PNG -o - -m 3 -s 6 "$url" | base64 | tr -d '\n') || deny "QR render failed"

# iTAK reads a connect string of "<name>,<host>,<port>,<protocol>" - four fields, no
# credentials in it. We were emitting "<host>,<user>,<pass>", which iTAK cannot parse
# and which put the password on screen to no purpose. common/generate_tak_qr.py has
# had the right shape since it was written; this line had drifted from it.
name=$(printf '%s' "$host" | cut -d. -f1)
[[ -n "$name" ]] || name="$host"

# Would a stock handset accept this server's certificate on sight? That single fact
# decides whether the code alone is the whole join or whether a file has to reach the
# device first, and the page has to say which - an operator who scans a code that cannot
# work gets no error anywhere, on the handset or here.
#
# Asked of the server, not inferred from how the box was built: a certificate can be
# replaced after provisioning, renewed, or fail to renew, and the only thing that decides
# what a device does is what the server presents on the wire today. 8446 is the connector
# devices enrol against. -verify_return_error turns a chain that does not reach a root in
# the system store into a non-zero exit, which is the same judgement the handset makes.
trusted=no
if command -v openssl >/dev/null 2>&1; then
    if </dev/null timeout 8 openssl s_client -connect 127.0.0.1:8446 \
            -servername "$host" -verify_return_error -verify_hostname "$host" \
            >/dev/null 2>&1; then
        trusted=yes
    fi
fi

echo "OK $user"
echo "PASS $pass"
echo "TRUSTED $trusted"
echo "URL $url"
echo "ITAK ${name},${host},8089,ssl"
echo "PNG $png"
# The data package, when the privileged half could build one. A box using a public
# certificate does not need it; a box using its own cannot enrol a device without it.
pkg=$(awk '$1=="PKG"{print $2}' <<<"$out")
[[ -n "$pkg" ]] && echo "PKG $pkg"
# "cert" means the package carries the device's own certificate and the join needs
# nothing typed; "enrol" means it carries trust only and the device will ask to log
# in. The page must not promise the first while shipping the second.
kind=$(awk '$1=="PKGKIND"{print $2}' <<<"$out")
[[ -n "$kind" ]] && echo "PKGKIND $kind"
