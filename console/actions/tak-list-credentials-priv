#!/usr/bin/env bash
# tak-list-credentials-priv - list the device credentials issued on this box, for the console's
# Credentials panel. Two kinds:
#   - client CERTIFICATES: any .p12 in /opt/tak/certs/files whose cert carries client-auth EKU
#     and NOT server-auth (that separates a device cert from the server and CA certs cleanly).
#   - ENROLMENT tokens: entries in /var/lib/tak-credentials/enrol, written when the console mints
#     an enrolment QR. Tokens created before that store existed are unrecoverable (the password
#     was never stored) and simply do not appear - they must be reissued, not re-downloaded.
#
# Emits one pipe-delimited row per credential; NO secret material leaves here. Root-only because
# /opt/tak/certs/files and the store are root-owned; reached through the sudoers-scoped wrapper.
#   takadmin ALL=(root) NOPASSWD: /usr/local/bin/tak-list-credentials-priv
set -euo pipefail
deny() { echo "ERR $*" >&2; exit 2; }

files=/opt/tak/certs/files
store=/var/lib/tak-credentials/enrol

if [[ -d "$files" ]]; then
    for pem in "$files"/*.pem; do
        [[ -e "$pem" ]] || continue
        n=$(basename "$pem" .pem)
        [[ -f "$files/$n.p12" ]] || continue
        case "$n" in *CA*|truststore*|*signing*) continue ;; esac
        eku=$(openssl x509 -in "$pem" -noout -ext extendedKeyUsage 2>/dev/null | tail -1 || true)
        grep -q "Client Authentication" <<<"$eku" || continue
        grep -q "Server Authentication" <<<"$eku" && continue
        exp=$(openssl x509 -in "$pem" -noout -enddate 2>/dev/null | cut -d= -f2 | tr -s ' ' | tr ' ' '_')
        echo "CERT|$n|${exp:-unknown}"
    done
fi

if [[ -d "$store" ]]; then
    for j in "$store"/*.json; do
        [[ -e "$j" ]] || continue
        n=$(basename "$j" .json)
        meta=$(python3 -c "import json;d=json.load(open('$j'));print(d.get('created',''),d.get('group',''))" 2>/dev/null || echo " ")
        echo "ENROL|$n|${meta% *}|${meta#* }"
    done
fi
echo "OK"
