#!/usr/bin/env python3
"""vantage-baseline - what third-party software a Vantage estate is built on, at which
version, and where to look when you want to know if that version is still current.

The point is maintaining a baseline. An operator upgrading a box, an auditor asking what is
in the stack, and an agent asked "are we behind on anything" all need the same list, and
until now there wasn't one: the versions were scattered across two provisioner scripts as
shell constants, some things were pinned by digest, one was not pinned at all, and TAK
Server's version lived in a comment.

    vantage-baseline                 the table, as an operator reads it
    vantage-baseline --json          the same thing for a machine or an agent
    vantage-baseline --write         regenerate docs/THIRD-PARTY.md + third-party.json
    vantage-baseline --check         ask each upstream what it has released (needs network)

THE RULE THAT KEEPS THIS HONEST: versions are READ OUT OF THE SHIPPED SCRIPTS, never typed
in here. A hand-written list of dependencies is a list that goes stale silently, which is
the same reasoning vantage-build-offline-bundle uses when it lets apt resolve its own
closure. And it works in both directions: a pinned constant in a provisioner with no entry
in this file is an error, not an omission, so nobody can add a dependency quietly.

What is deliberately NOT here: anything with a licence we do not hold. TAK Server is listed
because you must know which version an estate targets, but it is never downloaded, by this
or any other Vantage program.
"""
import argparse
import json
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
DOC = os.path.join(ROOT, "docs", "THIRD-PARTY.md")
JSON_OUT = os.path.join(ROOT, "console", "third-party.json")

# The scripts that are allowed to pin a third-party version. Anything matching PIN_RE in one
# of these must appear in COMPONENTS below, or --write and the test both fail.
PINNING_SCRIPTS = [
    "console/provision/vantage-tak-provision.sh",
    "console/provision/vantage-infratak-provision.sh",
]
PIN_RE = re.compile(r"^([A-Z][A-Z0-9_]*)=\"([^\"]*)\"", re.M)
# A constant naming a version is one whose name ends this way. Anything else in those
# scripts is configuration, not a dependency.
PIN_SUFFIXES = ("VER", "TAG", "DIGEST", "REF")

# Metadata cannot be derived, so it lives here: what the thing is, who publishes it, where to
# look for what they have released, its licence, and whether we can carry it onto a
# disconnected box. The VERSION never lives here. `pin` names the script and the constant it
# is read from; `fixed` is for the things no constant governs, and says where the version
# actually comes from instead.
