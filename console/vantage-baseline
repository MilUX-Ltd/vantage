def read_pins():
    """Every third-party version pinned in a shipped script, as {(script, name): value}."""
    pins = {}
    for rel in PINNING_SCRIPTS:
        path = os.path.join(ROOT, rel)
        if not os.path.exists(path):
            raise SystemExit(f"ERROR: {rel} is missing; the baseline cannot be built")
        for name, value in PIN_RE.findall(open(path).read()):
            if name.endswith(PIN_SUFFIXES):
                pins[(rel, name)] = value
    return pins


def build():
    """The baseline: metadata from this file, versions from the scripts. Raises if the two
    have drifted apart in either direction."""
    pins = read_pins()
    claimed, out = set(), []
    for c in COMPONENTS:
        entry = {k: c.get(k) for k in
                 ("id", "name", "what", "project", "releases", "licence", "offline", "note")}
        if "pin" in c:
            key = (c["pin"][0], c["pin"][1])
            if key not in pins:
                raise SystemExit(
                    f"ERROR: {c['id']} claims {key[1]} in {key[0]}, which is not there any "
                    f"more. Either the constant was renamed or the component was dropped; "
                    f"fix console/vantage-baseline rather than letting the list go stale.")
            claimed.add(key)
            entry["version"] = pins[key]
            entry["pinned_by"] = f"{key[0]}:{key[1]}"
        else:
            entry["version"] = c["fixed"]
            entry["pinned_by"] = None
        out.append(entry)
    missed = sorted(set(pins) - claimed)
    if missed:
        lines = "\n".join(f"    {n} in {s}" for s, n in missed)
        raise SystemExit(
            "ERROR: these versions are pinned in shipped scripts but are not in the "
            "baseline:\n" + lines + "\n  Add them to console/vantage-baseline. A dependency "
            "nobody recorded is one nobody can maintain.")
    return out


def as_markdown(rows):
    head = [
        "# Third-party software in a Vantage estate",
        "",
        "**Generated by `console/vantage-baseline`. Do not edit by hand.** The versions here",
        "are read out of the provisioner scripts, so this file cannot drift from what is",
        "actually installed; a pinned version with no entry here fails the build.",
        "",
        "Regenerate with `console/vantage-baseline --write`. Check what upstream has released",
        "with `console/vantage-baseline --check`, which needs the internet and changes",
        "nothing: it reports, and moving a pin stays a deliberate edit with a changelog note.",
        "",
        "| Component | Version | What it is | Licence | Offline |",
        "|---|---|---|---|---|",
    ]
    for r in rows:
        head.append(f"| [{r['name']}]({r['project']}) | `{r['version']}` | {r['what']} "
                    f"| {r['licence']} | {r['offline']} |")
    head += ["", "## Notes", ""]
    for r in rows:
        if r.get("note"):
            head.append(f"- **{r['name']}**: {r['note']}")
    head += [
        "",
        "## Where each version comes from",
        "",
    ]
    for r in rows:
        if r["pinned_by"]:
            head.append(f"- **{r['name']}** is pinned at `{r['pinned_by']}`.")
        else:
            head.append(f"- **{r['name']}** is not pinned by a constant: {r['version']}.")
    head += [
        "",
        "## What is never downloaded",
        "",
        "TAK Server is licensed to the operator. No Vantage program fetches it: you supply",
        "the `.deb`, online or on a stick. `vantage-build-offline-bundle` carries one only",
        "if you point it at yours.",
        "",
    ]
    return "\n".join(head)


def check(rows):
    """Ask each upstream what it has released. Read-only, and it never fails the run: a
    disconnected box is a supported way to use this product, not an error."""
    import urllib.request
    import urllib.error
    behind = 0
    for r in rows:
        if not r["releases"]:
            print(f"  --   {r['name'][:24]:24s} {str(r['version'])[:34]:34s} "
                  f"no release feed, check {r['project']}")
            continue
        try:
            req = urllib.request.Request(r["releases"], headers={"User-Agent": "vantage-baseline"})
            with urllib.request.urlopen(req, timeout=15) as fh:
                data = json.load(fh)
            latest = data[0]["name"] if isinstance(data, list) else data.get("tag_name", "?")
        except Exception as exc:  # offline, rate-limited, moved: all the same to us
            print(f"  ?    {r['name'][:24]:24s} {r['version'][:34]:34s} could not ask ({type(exc).__name__})")
            continue
        if latest == r["version"]:
            print(f"  ok   {r['name'][:24]:24s} {r['version'][:34]:34s} current")
        else:
            behind += 1
            print(f"  ->   {r['name'][:24]:24s} {r['version'][:34]:34s} upstream has {latest}")
    print()
    print(f"{behind} component(s) behind upstream. Nothing was changed: moving a pin is a "
          f"deliberate edit.")
    return behind


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--json", action="store_true", help="machine-readable, for an agent")
    ap.add_argument("--write", action="store_true", help="regenerate docs/THIRD-PARTY.md")
    ap.add_argument("--check", action="store_true", help="ask upstream what it has released")
    args = ap.parse_args()
    rows = build()
    if args.json:
        print(json.dumps({"components": rows}, indent=2))
        return 0
    if args.write:
        open(DOC, "w").write(as_markdown(rows))
        # The console reads the JSON, not this program. On an installed box the provisioner
        # scripts are not laid out the way they are in the repo, so the generator cannot run
        # there; the cut is where the sources exist, so the cut is where the fact is made.
        # Same reasoning as VERSIONS.
        open(JSON_OUT, "w").write(json.dumps({"components": rows}, indent=2) + "\n")
        print(f"wrote {os.path.relpath(DOC, ROOT)} and "
              f"{os.path.relpath(JSON_OUT, ROOT)} ({len(rows)} components)")
        return 0
    if args.check:
        print(f"Vantage third-party baseline, {len(rows)} components\n")
        check(rows)
        return 0
    print(f"Vantage third-party baseline, {len(rows)} components\n")
    for r in rows:
        print(f"  {r['name'][:26]:26s} {str(r['version'])[:46]:46s} {r['licence'][:34]}")
    print("\n--check asks upstream what it has released; --write regenerates the doc.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
